# ==============================
# База данных PostgreSQL
# ==============================
POSTGRES_DB=docscan
POSTGRES_USER=docscan
POSTGRES_PASSWORD=change_me_strong_password

# ==============================
# Redis
# ==============================
REDIS_PASSWORD=change_me_redis_password

# ==============================
# Строки подключения (заполняются автоматически из значений выше)
# ==============================
DATABASE_URL=postgresql+asyncpg://docscan:change_me_strong_password@postgres:5432/docscan
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# ==============================
# JWT
# ==============================
# Генерировать: openssl genrsa -out private.pem 2048
JWT_PRIVATE_KEY_PATH=/app/certs/private.pem
JWT_PUBLIC_KEY_PATH=/app/certs/public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================
# Шифрование файлов
# ==============================
# Генерировать: python -c "import secrets; print(secrets.token_hex(32))"
FILE_ENCRYPTION_MASTER_KEY=change_me_32_byte_hex_key

# ==============================
# Хранилище файлов
# ==============================
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
TEMP_FILE_TTL_SECONDS=3600

# ==============================
# Параметры приложения
# ==============================
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
MAX_FILE_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=60

# ==============================
# Первый администратор (создаётся при первом запуске)
# ==============================
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_FULL_NAME=Администратор системы
